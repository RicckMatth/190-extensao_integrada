{
  "manifest_version": 3,
  "name": "Relato 190 + Base de Conhecimento — MODELO TESTE",
  "version": "5.14.0",
  "description": "MODELO TESTE: ponte silenciosa de relato em tempo real; resultados exclusivamente no chat da Base 190.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite",
    "tabs",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Relato 190 + Base de Conhecimento (TESTE)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "host_permissions": [
    "https://viacep.com.br/*",
    "https://brasilapi.com.br/*",
    "https://servicodados.ibge.gov.br/*",
    "https://*.hereapi.com/*",
    "https://*.search.hereapi.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://base-conhecimento-190.vercel.app/*"
  ],
  "version_name": "5.14.0-relay-silent.1",
  "options_page": "kb190-options.html",
  "content_scripts": [
    {
      "matches": [
        "https://base-conhecimento-190.vercel.app/*"
      ],
      "js": [
        "kb190-bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "*://*/syspm-web/public/*",
        "http://localhost/*teste-sade*",
        "http://127.0.0.1/*teste-sade*",
        "http://localhost/*teste-atendimento*",
        "http://127.0.0.1/*teste-atendimento*"
      ],
      "js": [
        "bindings.js",
        "sade-adapter.js",
        "kb190-relay.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
