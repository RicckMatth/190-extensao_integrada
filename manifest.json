{
  "manifest_version": 3,
  "name": "Relato 190 + Base de Conhecimento — MODELO TESTE",
  "version": "5.12.0",
  "description": "MODELO TESTE: chat integrado, envio automático de relatos após autorização por sessão na Base 190, com HTTPS.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite",
    "tabs",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Relato 190 + Base de Conhecimento (TESTE)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "host_permissions": [
    "https://viacep.com.br/*",
    "https://brasilapi.com.br/*",
    "https://servicodados.ibge.gov.br/*",
    "https://*.hereapi.com/*",
    "https://*.search.hereapi.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://base-conhecimento-190.vercel.app/*"
  ],
  "version_name": "5.12.0-auto-chat.1",
  "options_page": "kb190-options.html",
  "content_scripts": [
    {
      "matches": [
        "https://base-conhecimento-190.vercel.app/*"
      ],
      "js": [
        "kb190-bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
