{
  "manifest_version": 3,
  "name": "Relato 190 + Base de Conhecimento — MODELO TESTE",
  "version": "5.10.0",
  "description": "MODELO TESTE: Relato 190 v5.9.3 com ponte de análise autenticada à Base 190 Node.js. NÃO HOMOLOGADO.",
  "permissions": [
    "activeTab",
    "scripting",
